{
  "name": "dsh-session-link",
  "version": "0.2.0",
  "description": "跨会话通信插件 for DeepSeek Harness：列出/读取已有会话，并把消息投递给另一个会话且不改变它的 agent preset 与模型。Cross-session messaging for DSH with envelope protocol, capability guard, receipts and audit.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./tools": "./lib/tools.js",
    "./envelope": "./lib/envelope.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "dsh.plugin.json",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "scripts"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session-query": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "smoke": "node scripts/smoke-host.mjs",
    "e2e": "node scripts/e2e-live.mjs",
    "probe:settings": "node scripts/probe-settings.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check": "for f in lib/*.js scripts/*.mjs; do node --check \"$f\"; done && node scripts/check-manifest.mjs && node --test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "session",
    "agent",
    "messaging",
    "inter-agent",
    "a2a",
    "multi-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZinChl/dsh-session-link.git"
  },
  "homepage": "https://github.com/ZinChl/dsh-session-link#readme",
  "bugs": {
    "url": "https://github.com/ZinChl/dsh-session-link/issues"
  },
  "license": "MIT",
  "author": "dw0x",
  "icon": "./icon.svg",
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
